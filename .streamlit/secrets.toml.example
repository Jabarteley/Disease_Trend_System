# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml itself - it's already in .gitignore.
#
# These are real OAuth credentials from an identity provider - this app
# cannot generate them for you. For Google (the provider the login button
# uses by default):
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (type: Web application)
#   3. Add an authorized redirect URI matching `redirect_uri` below exactly
#   4. Copy the generated Client ID and Client Secret into this file

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-string"
client_id = "your-google-oauth-client-id"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
